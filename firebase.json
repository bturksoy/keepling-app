{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "README.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(png|jpg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }]
      }
    ],
    "cleanUrls": true
  }
}
